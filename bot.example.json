{
  "auth": {
    "token": "REPLACEME",
    "intents": {
      "guilds": true,
      "guild_messages": true,
      "members": true,
      "message_content": true
    },
    "server": 1,
    "logs": {
      "public": {
        "channel_id": 1,
        "interested_parties": [
          1
        ]
      },
      "audit": {
        "channel_id": 1,
        "interested_parties": [
          1
        ]
      }
    }
  },
  "commands": {
    "scheduling": {
      "group_module": "match_scheduler_bot.bot.extensions.scheduling",
      "group_name": "match",
      "group_description": "commands related to match scheduling",
      "group_commands": {
        "create_match": {
          "invoke_with": "schedule",
          "description": "Schedule a match between two opposing teams",
          "parameters": {
            "team_1": "Affiliated team",
            "team_2": "Opposing team",
            "year": "The year this match will take place",
            "month": "The month this match will take place",
            "day": "The day of the month this match will take place",
            "hour": "The hour of day (in military time) this match will take place",
            "minute": "The minute of the hour this match will take place",
            "timezone": "The timezone identifier used to localize the provided date/time info"
          },
          "renames": {
            "team_1": "team¹",
            "team_2": "team²"
          },
          "allowlist": [
            1,
            1
          ]
        },
        "delete_match": {
          "invoke_with": "cancel",
          "description": "Cancel a match between two opposing teams",
          "parameters": {
            "team_1": "Affiliated team",
            "team_2": "Opposing team"
          },
          "renames": {
            "team_1": "team¹",
            "team_2": "team²"
          },
          "allowlist": [
            1,
            1
          ]
        },
        "get_match": {
          "invoke_with": "calendar",
          "description": "Display a list of upcoming matches",
          "parameters": {},
          "renames": {},
          "allowlist": null
        }
      }
    }
  },
  "data": {
    "database": "match.db",
    "messages": "messages/"
  }
}
